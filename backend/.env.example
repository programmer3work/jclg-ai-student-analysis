# Copy this file to .env and replace the placeholder values locally.
# Use a separate local development password; never commit a real password.
DATABASE_URL=postgresql+psycopg2://postgres:<local-dev-password>@localhost:5432/jclg_ai_student_analysis

# Add the real deployed frontend origin when deploying, for example:
# https://<ec2-domain-or-ip>:15004
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:3000,http://127.0.0.1:5500,https://<ec2-domain-or-ip>:15004
SUPPORTED_LANGUAGES=English,Telugu,Hindi
ANALYSIS_TYPES=Performance Review,Risk Analysis
RISK_LEVELS=low,moderate,high
DEFAULT_LANGUAGE=English
DEFAULT_ANALYSIS_TYPE=Performance
HIGH_RISK_LEVEL=high
IMPROVING_STATUS=improving
RISK_ATTENDANCE_THRESHOLD=75
RISK_MARKS_THRESHOLD=60
